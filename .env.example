# 仅保存在服务端。复制为 .env.local 后填写，不要提交真实密钥。
OPENAI_API_KEY=

# 填写你的 OpenAI 项目可用、支持结构化输出的模型名称。
OPENAI_MODEL=

# 固定本站地址，用于校验写操作来源；生产环境使用 HTTPS 地址。
APP_ORIGIN=http://localhost:3000

# 账户、会话、AI 设置和用量的持久化目录；Docker 中使用 /app/records/system。
APP_STATE_DIR=records/system

# 前端保存 AI 密钥必需。生成：node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# 请持久保存此值；更换后已有密钥无法解密。不可使用示例值或提交真实密钥。
APP_SETTINGS_KEY=

# 可选：首次启动自动创建管理员；已有管理员后忽略，绝无默认密码。
# 也可在终端运行 node scripts/admin-init.mjs 交互初始化（推荐）。
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 未列入参考单价的模型需填写估算单价（USD / 百万 token），或登录管理员面板设置。
OPENAI_INPUT_PRICE=
OPENAI_OUTPUT_PRICE=
