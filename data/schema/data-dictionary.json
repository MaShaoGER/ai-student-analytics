        },
        "completed_course_count": {
          "type": "integer",
          "description": "完成课程数，不等同于及格课程数"
        },
        "average_score": {
          "type": "number",
          "description": "本学期三门课程的平均成绩"
        },
        "scheduled_sessions": {
          "type": "integer",
          "description": "应到课时数；每门课每周 2 课时，每课时 45 分钟"
        },
        "attended_sessions": {
          "type": "integer",
          "description": "实际出勤课时数，等于正常到课 + 迟到 + 早退"
        },
        "present_sessions": {
          "type": "integer",
          "description": "正常到课课时数；不含迟到与早退"
        },
        "late_sessions": {
          "type": "integer",
