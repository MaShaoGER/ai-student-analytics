          "description": "无有效已批准请假的旷课课时数"
        },
        "attendance_rate": {
          "type": "number",
          "description": "出勤率（0–100%）= 实际出勤课时 / 应到课时 × 100；请假计入分母"
        },
        "assignment_count": {
          "type": "integer",
          "description": "应交作业数；每门课程 8 次作业"
        },
        "submitted_assignments": {
          "type": "integer",
          "description": "已交作业数，包含按时提交与迟交"
        },
        "on_time_assignments": {
          "type": "integer",
          "description": "按时提交作业数"
        },
        "late_assignments": {
          "type": "integer",
          "description": "迟交作业数"
        },
        "missing_assignments": {
          "type": "integer",
          "description": "未交作业数"
        },
        "homework_completion_rate": {
