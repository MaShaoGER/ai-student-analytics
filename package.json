{
  "name": "student-analytics",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "./scripts/test-api.sh",
    "admin:init": "node scripts/admin-init.mjs",
    "data:demo": "node scripts/generate-demo-data.mjs",
    "format": "prettier --write .",
    "test:recovery": "node --test scripts/recovery.test.mjs",
    "eval:ai": "AI_EVAL=1 vitest run scripts/ai-eval.test.ts",
    "eval:ai:mock": "AI_EVAL_MOCK=1 vitest run scripts/ai-eval.test.ts",
    "postbuild": "node scripts/prepare-standalone-native.mjs",
    "eval:ai:phase2": "AI_EVAL_PHASE2=1 vitest run scripts/ai-eval-phase2.test.ts",
    "eval:ai:unified": "AI_EVAL_UNIFIED=1 vitest run scripts/ai-eval-unified.test.ts",
    "eval:ai:unified:mock": "AI_EVAL_UNIFIED_MOCK=1 vitest run scripts/ai-eval-unified.test.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.5-r.5",
    "echarts": "^6.0.0",
    "fflate": "0.8.3",
    "motion": "^14.4.0",
    "next": "^16.4.2",
    "openai": "^7.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "read-excel-file": "9.3.12",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.8.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
